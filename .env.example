# ThreeFold HQ — environment variables (names only; never commit real values).
# NEXT_PUBLIC_* are exposed to the browser. Everything else is SERVER-ONLY.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, service role

# ── Internal / AI routes ──────────────────────────────────────────────────────
INTERNAL_API_SECRET=                # server-only bearer for internal routes
AI_API_SECRET=

# ── Plaid (Relay expense feed) ────────────────────────────────────────────────
# SERVER-ONLY — same handling tier as SUPABASE_SERVICE_ROLE_KEY. NOT NEXT_PUBLIC.
# The browser never sees these or the access_token; it only ever gets a short-lived
# link_token and transaction display data. Read-only, Transactions product only.
PLAID_CLIENT_ID=
PLAID_SECRET=                       # use the SANDBOX secret first; swap to the
                                    # production secret only after Plaid approves
                                    # production access.
PLAID_ENV=sandbox                   # "sandbox" | "production"

# Vercel Cron auth for the daily /api/plaid/sync run. Vercel injects this as
# "Authorization: Bearer <CRON_SECRET>" on scheduled invocations.
CRON_SECRET=

# ── Google / other ────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_BUSINESS_EMAIL=
